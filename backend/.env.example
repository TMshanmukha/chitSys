# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# MySQL Database Configuration
# You can change DB_HOST, DB_PORT, DB_NAME, DB_USER, and DB_PASSWORD below:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chitfund_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_CONNECTION_LIMIT=10
# Set DB_SSL=true for TiDB Cloud Serverless, Aiven, or cloud-hosted MySQL
DB_SSL=false
# Set AUTO_MIGRATE=true to automatically apply database migrations on server boot
AUTO_MIGRATE=false

# JWT & Authentication Security Secrets
JWT_SECRET=c8f8b3c98d6e4a2b10984f728190d65b71234a9e5c1284d728198f6230129abc
JWT_EXPIRES_IN=2h
COOKIE_SECRET=98a123f890b45c2198034e782910fedcba1234567890abcdef1234567890abcd

# Bootstrap Administrator (Initial Admin Account)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin
BOOTSTRAP_ADMIN_FULLNAME=Main Administrator
BOOTSTRAP_ADMIN_PHONE=9876543210
